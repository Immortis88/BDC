# BDC Backend Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.

# ─── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── MySQL ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=bdc_app
DB_PASSWORD=your_mysql_password_here
DB_NAME=bdc
# Create this dedicated user in MySQL/cPanel; give it SELECT, INSERT, UPDATE,
# DELETE on this database only. Use a separate account for schema migrations.
# Keep false for existing local development. For a remote DB, ask the host for
# verified TLS settings before enabling. Use an absolute path for a custom CA.
DB_SSL=false
# DB_SSL_CA_FILE=/absolute/path/to/provider-ca.pem

# ─── Sessions ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_secret

# ─── CORS ─────────────────────────────────────────────────
# Frontend dev server origin (Vite default)
CORS_ORIGIN=http://localhost:5173

# ─── Duplicate-fingerprint HMAC key ───────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FINGERPRINT_KEY=change_this_to_a_long_random_hex_key

# ─── Media ────────────────────────────────────────────────
# Fixed media root, relative to backend (absolute paths also supported).
MEDIA_ROOT=assets
MEDIA_BASE_URL=http://localhost:4000/media
